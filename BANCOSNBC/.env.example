# Copiar este archivo a ".env" (sin .example) en la misma carpeta que api.py
# y rellenar con los valores reales del proyecto Supabase "BANCONBC".
# El archivo .env real NUNCA se sube a git (ya está en .gitignore raíz).

# Dashboard Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co

# Project Settings → API → "service_role" / Secret key.
# NUNCA la Publishable/anon key aquí: el backend necesita saltarse RLS
# para poder escribir transacciones y leer/escribir todo el dominio.
SUPABASE_SECRET_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Ya existentes desde antes de la Fase 2 (opcional, ver api.py):
# FLASK_DEBUG=0
# CORS_ORIGINS=https://tu-frontend.com
# API_KEY=una-clave-larga-y-aleatoria
